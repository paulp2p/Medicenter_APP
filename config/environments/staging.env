NEW_COMMAND_TIMEOUT=120
APP_WAIT_ACTIVITY=*

# Tiempos robustez
UIA2_INSTALL_TIMEOUT=120000
UIA2_LAUNCH_TIMEOUT=120000
ADB_EXEC_TIMEOUT=120000

