# Plataforma
PLATFORM_NAME=Android
DEVICE_NAME=emulator-5554
AUTOMATION_NAME=UiAutomator2

# App (usa una modalidad)
# APP=C:/Users/paulr/SILTIUM/Medicenter_APP/apk/medicenter_app.apk
APP_PACKAGE=com.siltium.medicenter
